# =========================================================================
# Sophie IA — variables d'environnement
# Copier ce fichier en .env.local puis remplir les valeurs.
# NE JAMAIS commiter .env.local ni aucune vraie cle.
#
# Sur Vercel : Project Settings > Environment Variables.
#   - les variables NEXT_PUBLIC_ sont de type "Config" (elles partent dans le
#     navigateur, elles ne peuvent pas etre secretes) ;
#   - toutes les autres sont de type "Secret".
# Les NEXT_PUBLIC_ sont lues AU MOMENT DU BUILD : apres les avoir ajoutees,
# relancez un deploiement, sans quoi rien ne change.
# =========================================================================

# --- Application ---------------------------------------------------------
# En local : http://localhost:3000
# Sur Vercel (production) : https://zelicall.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development          # development | staging | production

# --- Supabase (requis) ---------------------------------------------------
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cle "service_role" : SERVEUR UNIQUEMENT. Ne jamais prefixer NEXT_PUBLIC_.
# Elle contourne toutes les regles d'isolation.
SUPABASE_SERVICE_ROLE_KEY=

# --- Chiffrement des secrets stockes en base (requis des la Phase 3) -----
# Chiffre les jetons d'agenda et de telephonie avant de les ecrire en base.
# Generer avec :  openssl rand -base64 32
# Changer cette cle rend illisibles tous les jetons deja stockes : les clients
# devront reconnecter leur agenda.
SECRETS_ENCRYPTION_KEY=

# --- Google Calendar (Phase 3) -------------------------------------------
# Console Google Cloud > APIs & Services > Credentials > OAuth client ID
# Type d'application : "Web application".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Doit correspondre EXACTEMENT a l'URI autorisee dans la console Google.
# Une difference d'un seul caractere fait echouer la connexion, y compris un
# slash final.
#   en local      : http://localhost:3000/api/integrations/google/callback
#   en production : https://zelicall.com/api/integrations/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# --- Traitements planifies (Phase 3) -------------------------------------
# Protege /api/jobs/* . Sans l'un de ces deux secrets, le job refuse tout.
#
# CRON_SECRET est le nom attendu par Vercel : quand cette variable existe,
# Vercel l'envoie automatiquement en en-tete Authorization sur chaque
# declenchement planifie. C'est celle a definir sur Vercel.
# JOB_RUNNER_SECRET sert au declenchement manuel ou depuis un autre
# ordonnanceur.
# Generer avec :  openssl rand -base64 32
CRON_SECRET=
JOB_RUNNER_SECRET=

# =========================================================================
# Phase 4 — telephonie et voix. Declarees ici, pas encore utilisees.
# Voir ADR-020 pour le choix des fournisseurs.
# =========================================================================

# --- Fournisseur de voix : Vapi, region europeenne ------------------------
VOICE_PROVIDER=vapi
# Doit correspondre a la REGION de votre compte Vapi. Une cle americaine
# envoyee au serveur europeen est refusee exactement comme une cle fausse.
#   compte americain : https://api.vapi.ai
#   compte europeen  : https://api.eu.vapi.ai   (reserve aux contrats Premier)
# ADR-026 : la region europeenne n'est pas accessible en libre-service.
VOICE_API_BASE_URL=https://api.vapi.ai
VOICE_API_KEY=
# Secret partage servant a signer les appels d'outils entrants.
# Generer avec :  openssl rand -base64 32
VOICE_WEBHOOK_SECRET=

# --- Declaration des outils chez le fournisseur (script local) ------------
# Utilisees uniquement par `npm run vapi:tools`, jamais par l'application.
# Ne les mettez PAS sur Vercel : ce script tourne sur votre machine.
#
# SOPHIE_ORG_ID : l'identifiant de votre organisation
#   select id, name from organizations;
# VOICE_ASSISTANT_ID : facultatif, rattache les outils a cet assistant
SOPHIE_ORG_ID=
VOICE_ASSISTANT_ID=

# --- Telephonie ----------------------------------------------------------
TELEPHONY_PROVIDER=twilio
TELEPHONY_ACCOUNT_SID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_WEBHOOK_SECRET=

# --- Messagerie / SMS (Phase 6) ------------------------------------------
MESSAGING_PROVIDER=mock
MESSAGING_API_KEY=
MESSAGING_SENDER_ID=

# --- IA post-appel : transcription, resume, extraction (Phase 5) ---------
AI_PROVIDER=mock
AI_API_KEY=

# =========================================================================
# Tests d'isolation multi-tenant — MACHINE LOCALE UNIQUEMENT
# Ne jamais placer ces variables sur Vercel : les tests ne s'y executent pas,
# et ce serait une copie de plus du secret le plus sensible.
# Laisser vide = la suite d'isolation est ignoree (jamais verte a tort).
# =========================================================================
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
