# =========================================================================
# Sophie IA — variables d'environnement
# Copier ce fichier en .env.local puis remplir les valeurs.
# NE JAMAIS commiter .env.local ni aucune vraie cle.
# =========================================================================

# --- Application ---------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development          # development | staging | production

# --- Supabase (Phase 0 — requis) -----------------------------------------
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cle "service_role" : SERVEUR UNIQUEMENT. Ne jamais prefixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Tests d'isolation multi-tenant (optionnel, Phase 0) -----------------
# Laisser vide = les tests d'integration sont ignores automatiquement.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# =========================================================================
# Phases suivantes — declares ici pour memoire, non requis en Phase 0
# =========================================================================

# --- Google Calendar (Phase 3) ------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# --- Telephonie (Phase 4) ------------------------------------------------
TELEPHONY_PROVIDER=mock                  # mock | twilio | ...
TELEPHONY_ACCOUNT_SID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_WEBHOOK_SECRET=

# --- Voice AI (Phase 4) --------------------------------------------------
VOICE_PROVIDER=mock
VOICE_API_KEY=
VOICE_WEBHOOK_SECRET=

# --- Messagerie / SMS (Phase 6) ------------------------------------------
MESSAGING_PROVIDER=mock
MESSAGING_API_KEY=
MESSAGING_SENDER_ID=

# --- IA post-appel : transcription, resume, extraction (Phase 5) ---------
AI_PROVIDER=mock
AI_API_KEY=

# --- Traitements asynchrones (Phase 5) -----------------------------------
JOB_RUNNER_SECRET=                       # protege /api/jobs/run appele par Vercel Cron
